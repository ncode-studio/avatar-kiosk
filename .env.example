# ================================
# AI Avatar Kiosk - Configurazione
# ================================

# ── Server ────────────────────────────────────────────────────────────────
# Porta su cui gira il server (default: 3000)
PORT=3000

# ── Admin ─────────────────────────────────────────────────────────────────
# Credenziali pannello di amministrazione
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# ── Anthropic ─────────────────────────────────────────────────────────────
# API Key per Claude (AI provider)
# Ottieni su: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Modello Claude di default (può essere sovrascritto per ogni avatar)
CLAUDE_MODEL=claude-sonnet-4-6

# ── OpenAI ────────────────────────────────────────────────────────────────
# API Key per OpenAI (usata per GPT e/o Whisper STT)
# Ottieni su: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# ── STT provider ──────────────────────────────────────────────────────────
# Provider STT globale di default: openai (Whisper cloud) | nigen (self-hosted)
STT_PROVIDER=openai
# Modello Whisper di default (usato da STT_PROVIDER=openai e da avatar con stt_model vuoto)
STT_MODEL=whisper-1
# Lingua trascrizione (ISO 639-1, es. it / en / es)
STT_LANGUAGE=it
# Endpoint nigen_ml_stt, fornito dall'infra. Usato solo se STT_PROVIDER=nigen
# o se un avatar ha stt_provider=nigen. Lasciare vuoto se si usa solo openai.
STT_NIGEN_URL=
# STT_NIGEN_API_KEY=   # opzionale: header auth, se l'endpoint lo richiede

# ── ElevenLabs TTS ────────────────────────────────────────────────────────
# API Key per la sintesi vocale
# Ottieni su: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ID voce ElevenLabs di default
# Trovi le voci su: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
